# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app ###
# PUBLISH_API_TOKEN is deliberately absent: it is the shared secret callers send
# as `Authorization: Bearer <token>`, so a default here would be a publicly
# known one committed to the repo. Every docker compose file sets it explicitly.
# Blank, every request gets a 401. Unset, the env var cannot be resolved, so a
# caller that does send a token gets a 500 and nothing is ever enqueued -- the
# handler that reads it is only constructed once a token has been extracted.
# Either way a misconfigured deployment is closed, not open.
###< app ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/amqp-messenger ###
# AMQP_DSN is deliberately absent: an unset DSN is a broken deployment, and a
# default here would only turn that into a confusing connection error against a
# host nobody configured. All compose files set it explicitly.
#
# The heartbeat does get a default, because the hand-written connection this
# replaced had one built in (10s) and dropping it silently would be a
# regression. Must match `heartbeat` in docker/rabbitmq-config/rabbitmq.conf.
AMQP_HEARTBEAT=10
###< symfony/amqp-messenger ###
