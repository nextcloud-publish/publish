# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Tests must never write into the volume shared with ssg-worker. Kernel-booting
# tests only need this to resolve; the ones that actually create folders point
# JobWorkspace at a temporary directory themselves.
JOB_STORAGE_DIR=var/jobs-test
