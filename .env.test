# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The transports are overridden to in-memory:// under when@test, but a scalar
# override merges over the base node rather than replacing it, so the options
# block is still resolved when the transport is built -- and this placeholder
# with it.
AMQP_HEARTBEAT=10

# JobLayout is constructed whenever the container compiles, which
# `bin/console lint:container` does in CI. The paths are never written to by the
# unit tests (each builds its own temp tree), so these only have to resolve.
JOB_STORAGE_DIR='/tmp/ssg-test/build_temp'
PUBLISHED_DIR='/tmp/ssg-test/published'
FAILED_DIR='/tmp/ssg-test/build_failed'
