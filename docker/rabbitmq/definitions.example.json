{
  "rabbit_version": "4.0.0",
  "comment": "Topology for publish and ssg-worker; docker/dev/rabbitmq/README.md explains it. Copy to definitions.json; https://github.com/nextcloud-publish/publish/wiki/Deploy-publish fills in the hash.",

  "users": [
    {
      "name": "publish",
      "password_hash": "<PASSWORD_HASH>",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    }
  ],

  "vhosts": [
    { "name": "/" }
  ],

  "permissions": [
    {
      "user": "publish",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],

  "policies": [],
  "parameters": [],
  "global_parameters": [],
  "topic_permissions": [],

  "exchanges": [
    {
      "name": "delays",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "q.builds",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],

  "bindings": []
}
