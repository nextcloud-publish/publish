# Copy to .env; compose.yaml reads it. Every value has a default.

# Host ids publish and publish-worker run as, so they can write var/ in the checkouts.
PUBLISH_UID=1000
PUBLISH_GID=1000
PUBLISH_WORKER_UID=1000
PUBLISH_WORKER_GID=1000

# Postgres major version, 18 or later: the image tag and Doctrine's serverVersion.
#POSTGRES_VERSION=18

#TZ=Europe/Berlin
