# Copy to .env and fill in the required values. compose.yaml reads it.

# --- Required

# Shared secret callers send as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
PUBLISH_API_TOKEN=

# Password of the RabbitMQ user "publish"; its hash goes into rabbitmq/definitions.json.
# Hex only: it goes into a URL. Generate: openssl rand -hex 32
RABBITMQ_PASSWORD=

# Public URL the host proxy serves pages/ at.
# A site's publish_url is <PUBLISH_BASE_URL>/<static_site_id>/<slug>/.
PUBLISH_BASE_URL=https://publish.example.org/pages

# --- Optional, with their defaults

# Port on 127.0.0.1 the host proxy forwards the API to.
#PUBLISH_PORT=8080

#PUBLISH_IMAGE=ghcr.io/nextcloud-publish/publish:latest
#SSG_WORKER_IMAGE=ghcr.io/nextcloud-publish/ssg-worker:latest
#SSG_WORKER_REPLICAS=2

# Ceiling on one content download, in megabytes.
#MAX_DOWNLOAD_MB=256

# debug, info, notice, warning or error.
#LOG_LEVEL=info

#TZ=Europe/Berlin

# GlitchTip or Sentry DSN per service; unset sends nothing.
#PUBLISH_SENTRY_DSN=
#SSG_WORKER_SENTRY_DSN=
